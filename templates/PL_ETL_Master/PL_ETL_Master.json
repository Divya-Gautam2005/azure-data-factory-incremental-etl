{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"LS_OnPremSQL": {
			"type": "string"
		},
		"LS_ADLS": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_ETL_Master')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_Control",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": "SELECT\n    SourceSchema,\n    SourceTable,\n    WatermarkColumn,\n    LastWatermark,\n    LoadType,\n    TargetFolder\nFROM dbo.ETL_Control\nWHERE IsActive = 1;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_Generic",
								"type": "DatasetReference",
								"parameters": {
									"SchemaName": "dbo",
									"TableName": "ETL_Control"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_Control",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_Control').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "COPY_Data",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "Set_StartTime",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": {
												"value": "@if(\n    equals(item().LoadType,'FULL'),\n    concat(\n        'SELECT * FROM ',\n        item().SourceSchema,\n        '.',\n        item().SourceTable\n    ),\n    concat(\n        'SELECT * FROM ',\n        item().SourceSchema,\n        '.',\n        item().SourceTable,\n        ' WHERE ',\n        item().WatermarkColumn,\n        ' > ''',\n        string(item().LastWatermark),\n        ''''\n    )\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_Generic",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@item().SourceSchema",
													"type": "Expression"
												},
												"TableName": {
													"value": "@item().SourceTable",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Generic",
											"type": "DatasetReference",
											"parameters": {
												"Container": "raw",
												"Folder": "@item().TargetFolder",
												"FileName": {
													"value": "@concat(\n    item().SourceTable,\n    '_',\n    formatDateTime(utcnow(),'yyyyMMddHHmmss'),\n    '.csv'\n)",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Lookup_New_Watermark",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "COPY_Data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": "@concat(\n    'SELECT MAX(',\n    item().WatermarkColumn,\n    ') AS NewWatermark FROM ',\n    item().SourceSchema,\n    '.',\n    item().SourceTable\n)",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_SQL_Generic",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@item().SourceSchema",
													"type": "Expression"
												},
												"TableName": {
													"value": "@item().SourceTable",
													"type": "Expression"
												}
											}
										}
									}
								},
								{
									"name": "Update_Watermark",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "Lookup_New_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[dbo].[Update_ETL_Watermark]",
										"storedProcedureParameters": {
											"TableName": {
												"value": {
													"value": "@item().SourceTable\r\n",
													"type": "Expression"
												},
												"type": "String"
											},
											"NewWatermark": {
												"value": "@activity('Lookup_New_Watermark').output.firstRow.NewWatermark",
												"type": "Datetime"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "[parameters('LS_OnPremSQL')]",
										"type": "LinkedServiceReference",
										"parameters": {
											"ServerName": "localhost\\SQLEXPRESS",
											"DatabaseName": "ADF_Incremental_ETL"
										}
									}
								},
								{
									"name": "Log_Success",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "Update_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[dbo].[Log_ETL_Process]",
										"storedProcedureParameters": {
											"PipelineName": {
												"value": "@pipeline().Pipeline",
												"type": "String"
											},
											"TableName": {
												"value": "@item().SourceTable",
												"type": "String"
											},
											"LoadType": {
												"value": "@item().LoadType",
												"type": "String"
											},
											"StartTime": {
												"value": {
													"value": "@variables('StartTime')",
													"type": "Expression"
												},
												"type": "Datetime"
											},
											"EndTime": {
												"value": "@utcnow()",
												"type": "Datetime"
											},
											"Status": {
												"value": "Success",
												"type": "String"
											},
											"RowsCopied": {
												"value": {
													"value": "@activity('COPY_Data').output.rowsCopied",
													"type": "Expression"
												},
												"type": "Int32"
											},
											"ErrorMessage": {
												"value": null,
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "[parameters('LS_OnPremSQL')]",
										"type": "LinkedServiceReference",
										"parameters": {
											"ServerName": "localhost\\SQLEXPRESS",
											"DatabaseName": "ADF_Incremental_ETL"
										}
									}
								},
								{
									"name": "Set_StartTime",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "StartTime",
										"value": "@utcnow()"
									}
								},
								{
									"name": "Log_Failure",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "COPY_Data",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[dbo].[Log_ETL_Process]",
										"storedProcedureParameters": {
											"PipelineName": {
												"value": "@pipeline().Pipeline",
												"type": "String"
											},
											"TableName": {
												"value": "@item().SourceTable",
												"type": "String"
											},
											"LoadType": {
												"value": "@item().LoadType",
												"type": "String"
											},
											"StartTime": {
												"value": {
													"value": "@variables('StartTime')",
													"type": "Expression"
												},
												"type": "Datetime"
											},
											"EndTime": {
												"value": "@utcnow()",
												"type": "Datetime"
											},
											"Status": {
												"value": "Failed",
												"type": "String"
											},
											"RowsCopied": {
												"value": null,
												"type": "Int32"
											},
											"ErrorMessage": {
												"value": {
													"value": "@activity('COPY_Data').error.message",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "[parameters('LS_OnPremSQL')]",
										"type": "LinkedServiceReference",
										"parameters": {
											"ServerName": "localhost\\SQLEXPRESS",
											"DatabaseName": "ADF_Incremental_ETL"
										}
									}
								}
							]
						}
					}
				],
				"variables": {
					"StartTime": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_SQL_Generic')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Generic')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_SQL_Generic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('LS_OnPremSQL')]",
					"type": "LinkedServiceReference",
					"parameters": {
						"ServerName": "localhost\\SQLEXPRESS",
						"DatabaseName": "ADF_Incremental_ETL"
					}
				},
				"parameters": {
					"SchemaName": {
						"type": "string"
					},
					"TableName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "SqlServerTable",
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_Generic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('LS_ADLS')]",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"Container": {
						"type": "string"
					},
					"Folder": {
						"type": "string"
					},
					"FileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().FileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().Folder",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().Container",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": []
		}
	]
}