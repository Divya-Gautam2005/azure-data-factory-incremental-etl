{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-Practice0"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"LS_OnPremSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_OnPremSQL'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://divya12.dfs.core.windows.net/"
		},
		"LS_OnPremSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_OnPremSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"LS_OnPremSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "DIVYAGAUTAM\\Divya Gautam"
		},
		"integrationRuntime1_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4ba37642-afc3-4c59-9758-b9ce27d9ea7f/resourcegroups/free-rg/providers/Microsoft.DataFactory/factories/a-d-f-1/integrationruntimes/SHIR-AdventureWorks"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-Practice0_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_OnPremSQL_password": {
						"value": "[parameters('LS_OnPremSQL_password')]"
					},
					"integrationRuntime1_properties_typeProperties_linkedInfo_resourceId": {
						"value": "[parameters('integrationRuntime1_properties_typeProperties_linkedInfo_resourceId')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_OnPremSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_OnPremSQL_properties_typeProperties_server')]"
					},
					"LS_OnPremSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_OnPremSQL_properties_typeProperties_database')]"
					},
					"LS_OnPremSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_OnPremSQL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}